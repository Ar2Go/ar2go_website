# Variables de entorno — AR2GO website
# Copia este archivo a .env.local y completa los valores reales.
# Ninguna variable de aquí bloquea correr el sitio en local (ver CLAUDE.md §9).

# Resend (envío de correo del formulario de demo — paso 5 del PLAN.md).
# Pendiente: la cuenta de Resend todavía no existe. No bloquea el resto del
# trabajo; el formulario y su Server Action se implementan en el paso 5.
RESEND_API_KEY=

# Auth.js (login con Google para /admin, ver CLAUDE.md §11 — decisión del
# panel de administración). Pendiente: crear las credenciales OAuth en
# Google Cloud Console (Authorized redirect URI:
# https://<dominio>/api/auth/callback/google, y http://localhost:3000/api/auth/callback/google
# para local). No bloquea el resto del sitio — sin estas variables, /admin
# no deja iniciar sesión, pero el resto de las páginas funciona igual.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
